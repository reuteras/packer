set windows-shell := ["pwsh", "-NoLogo", "-NoProfile", "-Command"]

export CHECKPOINT_DISABLE := env("CHECKPOINT_DISABLE", "1")

# Build the default VM (Debian 13 arm64)
default: build-debian-arm-qemu

# Build Debian 13 arm64 VM for VMware Fusion
[working-directory('debian-arm-qemu')]
build-debian-arm-qemu:
    packer init debian-arm-qemu.pkr.hcl
    packer build -force -var-file ../variables-debian-arm.pkr.hcl debian-arm-qemu.pkr.hcl
    ../../scripts/qcow2-to-fusion.sh Debian_64-bit Debian_64-bit 8192 2 arm-debian13-64

# Build Malcolm (network traffic analysis) on Debian 13 arm64
[working-directory('malcolm-arm-qemu')]
build-malcolm-arm-qemu:
    packer init malcolm-arm-qemu.pkr.hcl
    packer build -force -var-file ../variables-debian-arm.pkr.hcl malcolm-arm-qemu.pkr.hcl
    ../../scripts/qcow2-to-fusion.sh Malcolm_Debian_64-bit Malcolm_Debian_64-bit 24576 6 arm-debian13-64

# Build Arkime (full packet capture) on Debian 13 arm64
[working-directory('arkime-arm-qemu')]
build-arkime-arm-qemu:
    packer init arkime-arm-qemu.pkr.hcl
    packer build -force -var-file ../variables-debian-arm.pkr.hcl arkime-arm-qemu.pkr.hcl
    ../../scripts/qcow2-to-fusion.sh Arkime_Debian_64-bit Arkime_Debian_64-bit 16384 4 arm-debian13-64

# Move built VMs to the Fusion VM folder and open them (macOS only; Windows builds install themselves)
[macos]
install:
    ../bin/install.sh

# Build Debian 13 amd64 VM for VMware Workstation (Windows)
[windows]
build-debian:
    pwsh -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-vm.ps1 -Base debian -Conf debian -VmDirName Debian_64-bit

# Build Debian 13 amd64 VM for VMware Workstation Pro (Linux)
[linux]
build-debian:
    ../scripts/build-vm.sh debian debian Debian_64-bit
