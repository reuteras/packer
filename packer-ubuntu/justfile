set windows-shell := ["pwsh", "-NoLogo", "-NoProfile", "-Command"]

export CHECKPOINT_DISABLE := env("CHECKPOINT_DISABLE", "1")

# Build the default VM (Ubuntu 24.04 arm64)
default: build-ubuntu-2404-arm-qemu

# Build Ubuntu 24.04 desktop arm64 VM for VMware Fusion
[working-directory('ubuntu-2404-arm-qemu')]
build-ubuntu-2404-arm-qemu:
    packer init ubuntu-2404-arm-qemu.pkr.hcl
    packer build -force -var-file ../variables-ubuntu-2404-arm.pkr.hcl ubuntu-2404-arm-qemu.pkr.hcl
    ../../scripts/qcow2-to-fusion.sh Ubuntu_24.04_64-bit_arm Ubuntu_24.04_64-bit_arm 8192 2 arm-ubuntu-64

# Build REMnux (malware analysis) on Ubuntu 24.04 arm64
[working-directory('remnux-arm-qemu')]
build-remnux-arm-qemu:
    packer init remnux-arm-qemu.pkr.hcl
    packer build -force -var-file ../variables-ubuntu-2404-arm.pkr.hcl remnux-arm-qemu.pkr.hcl
    ../../scripts/qcow2-to-fusion.sh REMnux_arm64 REMnux_arm64 8192 4 arm-ubuntu-64

# Build SIFT Workstation (forensics) on Ubuntu 24.04 arm64
[working-directory('sift-arm-qemu')]
build-sift-arm-qemu:
    packer init sift-arm-qemu.pkr.hcl
    packer build -force -var-file ../variables-ubuntu-2404-arm.pkr.hcl sift-arm-qemu.pkr.hcl
    ../../scripts/qcow2-to-fusion.sh SIFT_arm64 SIFT_arm64 8192 4 arm-ubuntu-64

# Move built VMs to the Fusion VM folder and open them (macOS only; Windows builds install themselves)
[macos]
install:
    ../bin/install.sh

# Remove build output
[unix]
clean:
    rm -rf ubuntu-2404-arm-qemu/Ubuntu_24.04_64-bit_arm remnux-arm-qemu/REMnux_arm64 sift-arm-qemu/SIFT_arm64

# Remove build output and the packer ISO cache
[unix]
dist-clean: clean
    rm -rf packer_cache

# Build Ubuntu 24.04 amd64 VM for VMware Workstation (Windows)
[windows]
build-ubuntu-2404:
    pwsh -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-vm.ps1 -Base ubuntu-2404 -Conf ubuntu-2404 -VmDirName Ubuntu_24.04_64-bit
# Build REMnux (malware analysis) amd64 VM for VMware Workstation (Windows)
[windows]
build-remnux:
    pwsh -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-vm.ps1 -Base ubuntu-2404 -Conf remnux -VmDirName REMnux_64-bit

# Build SIFT Workstation (forensics) amd64 VM for VMware Workstation (Windows)
[windows]
build-sift:
    pwsh -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-vm.ps1 -Base ubuntu-2404 -Conf sift -VmDirName SIFT_64-bit

# Build Ubuntu 24.04 amd64 VM for VMware Workstation Pro (Linux)
[linux]
build-ubuntu-2404:
    ../scripts/build-vm.sh ubuntu-2404 ubuntu-2404 Ubuntu_24.04_64-bit

# Build REMnux (malware analysis) amd64 VM for VMware Workstation Pro (Linux)
[linux]
build-remnux:
    ../scripts/build-vm.sh ubuntu-2404 remnux REMnux_64-bit

# Build SIFT Workstation (forensics) amd64 VM for VMware Workstation Pro (Linux)
[linux]
build-sift:
    ../scripts/build-vm.sh ubuntu-2404 sift SIFT_64-bit
